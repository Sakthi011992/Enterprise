// POS Billing — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT_CARD
  DEBIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum AccessLevel {
  NONE
  VIEW
  REQUEST
  LIMITED
  APPROVE
  EDIT
}

enum PersonaLoginMethod {
  PASSWORD
  PIN
}

enum DeviceType {
  POS_TABLET
  KDS
  TV
  KIOSK
  PRINTER
  PHONE
}

// ---------------------------------------------------------------------------
// Tenancy, outlets, personas
// ---------------------------------------------------------------------------

model Tenant {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  outlets            Outlet[]
  personas           Persona[]
  users              User[]
  products           Product[]
  globalTaxSettings  GlobalTaxSetting[]
  orders             Order[]
  productImportLogs  ProductImportLog[]
  auditLogs          AuditLog[]
  devices            Device[]
  notifications      Notification[]

  @@map("tenants")
}

model Outlet {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  code        String
  address     String?
  timezone    String   @default("Asia/Kolkata")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userOutlets UserOutlet[]
  devices     Device[]
  orders      Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("outlets")
}

model Persona {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  key         String
  name        String
  description String?
  homeRoute   String      @default("/dashboard")
  loginMethod PersonaLoginMethod @default(PASSWORD)
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  permissions PersonaPermission[]
  userOutlets UserOutlet[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("personas")
}

model Permission {
  key                String  @id
  group              String
  label              String
  description        String?
  limitUnit          String? // "percent" | "inr" | null
  sortOrder          Int     @default(0)
  personaPermissions PersonaPermission[]

  @@map("permissions")
}

model PersonaPermission {
  personaId     String
  persona       Persona     @relation(fields: [personaId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission  @relation(fields: [permissionKey], references: [key])
  level         AccessLevel @default(NONE)
  limitValue    Decimal?    @db.Decimal(12, 2)

  @@id([personaId, permissionKey])
  @@map("persona_permissions")
}

model UserOutlet {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id])
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([userId, outletId])
  @@index([personaId])
  @@map("user_outlets")
}

model StaffPin {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("staff_pins")
}

model Device {
  id         String     @id @default(uuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  outletId   String
  outlet     Outlet     @relation(fields: [outletId], references: [id])
  name       String
  type       DeviceType
  keyHash    String     @unique // sha256 of the device key
  lastSeenAt DateTime?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@index([tenantId])
  @@index([outletId])
  @@map("devices")
}

model Notification {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  outletId      String?
  userId        String?   // null = for everyone with `permissionKey`
  permissionKey String?
  type          String    // "approval" | "alert" | "device" | "stock" | "info"
  title         String
  body          String?
  data          Json?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Users and business data
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN | USER
  description String?
  createdAt   DateTime @default(now())
  users       User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  username     String    @unique
  email        String?   @unique
  displayName  String?
  phone        String?
  passwordHash String?   // null for OAuth-only users
  roleId       String    // deprecated: removed in Phase 2 (use userOutlets/persona)
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0) // bump to revoke refresh tokens
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft delete

  orders            Order[]
  importLogs        ProductImportLog[]
  auditLogs         AuditLog[]
  themesCreated     Theme[]
  themeAssignments  ThemeAssignment[]
  featureGrants     UserFeatureGrant[] // deprecated: replaced by persona permissions in Phase 2
  oauthAccounts     OAuthAccount[]
  kioskConfig       KioskConfig?
  localePreference  UserLocalePreference?
  userOutlets       UserOutlet[]
  staffPin          StaffPin?
  resetTokens       PasswordResetToken[]

  @@index([tenantId])
  @@index([username])
  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Product {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  name           String
  description    String?
  price          Decimal   @db.Decimal(12, 2)
  taxPercentage  Decimal?  @db.Decimal(5, 2) // null => use global tax
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // soft delete

  orderItems    OrderItem[]
  images        ProductImage[]
  featuredItems FeaturedItem[]

  @@index([tenantId])
  @@index([name])
  @@index([isActive])
  @@map("products")
}

model GlobalTaxSetting {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  percentage Decimal  @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([isActive])
  @@map("global_tax_settings")
}

model Order {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  outletId      String? // nullable in Phase 1; set on new orders when the request has an outlet
  outlet        Outlet?     @relation(fields: [outletId], references: [id])
  invoiceNumber String      @unique
  cashierId     String
  cashier       User        @relation(fields: [cashierId], references: [id])
  subtotal      Decimal     @db.Decimal(12, 2)
  taxAmount     Decimal     @db.Decimal(12, 2)
  grandTotal    Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]

  @@index([tenantId])
  @@index([outletId])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([cashierId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  productName   String  // snapshot
  price         Decimal @db.Decimal(12, 2) // snapshot
  quantity      Int
  taxPercentage Decimal @db.Decimal(5, 2)  // snapshot of resolved rate
  taxAmount     Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PAID)
  createdAt     DateTime      @default(now())

  gatewayEventIds String[] @default([])

  @@index([orderId])
  @@map("payments")
}

model ProductImportLog {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  fileName     String
  totalRows    Int
  insertedRows Int
  skippedRows  Int
  failedRows   Int
  errors       Json?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([uploadedById])
  @@map("product_import_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([entity])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Feature toggles
// ---------------------------------------------------------------------------

enum AppFeature {
  DASHBOARD
  PRODUCTS
  TAX
  USERS
  ORDERS
  APPEARANCE
}

model UserFeatureGrant {
  userId    String
  feature   AppFeature
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime   @default(now())

  @@id([userId, feature])
  @@index([userId])
  @@map("user_feature_grants")
}

// ---------------------------------------------------------------------------
// Theming
// ---------------------------------------------------------------------------

enum Platform {
  WEB
  ANDROID
  IOS
}

model Theme {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  tokens        Json
  schemaVersion Int       @default(1)
  revision      Int       @default(1)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id])

  assignments ThemeAssignment[]
  logos       BrandLogo[]

  @@index([deletedAt])
  @@map("themes")
}

model ThemeAssignment {
  platform    Platform @id
  themeId     String
  theme       Theme    @relation(fields: [themeId], references: [id], onDelete: Restrict)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@index([themeId])
  @@map("theme_assignments")
}

// ---------------------------------------------------------------------------
// Branding / Logo upload
// ---------------------------------------------------------------------------

enum LogoRole {
  WORDMARK
  ICON_MARK
}

enum LogoVariant {
  LIGHT
  DARK
}

model BrandLogo {
  id              String      @id @default(uuid())
  themeId         String
  theme           Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  role            LogoRole
  variant         LogoVariant
  mimeType        String
  sizeBytes       Int
  contentHash     String
  blobPath        String
  width           Int?
  height          Int?
  createdAt       DateTime    @default(now())

  @@unique([themeId, role, variant])
  @@map("brand_logos")
}

// ---------------------------------------------------------------------------
// Localisation
// ---------------------------------------------------------------------------

model TranslationKey {
  id          String             @id @default(uuid())
  key         String             @unique
  description String?
  createdAt   DateTime           @default(now())
  values      TranslationValue[]

  @@map("translation_keys")
}

model TranslationValue {
  id        String         @id @default(uuid())
  keyId     String
  key       TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  locale    String         // e.g. "en", "hi", "ja", "kn"
  value     String
  updatedAt DateTime       @updatedAt

  @@unique([keyId, locale])
  @@index([locale])
  @@map("translation_values")
}

model UserLocalePreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale    String   @default("en")
  updatedAt DateTime @updatedAt

  @@map("user_locale_preferences")
}

// ---------------------------------------------------------------------------
// Billing & Audit (Invoice)
// ---------------------------------------------------------------------------

enum NumberResetPeriod {
  NEVER
  CALENDAR_YEAR
  FINANCIAL_YEAR
}

enum TaxBreakdownMode {
  SINGLE_LINE
  SPLIT_COMPONENTS
}

enum RoundingRule {
  ROUND_PER_LINE
  ROUND_TOTAL
}

enum InvoiceStatus {
  ISSUED
  VOIDED
  CREDIT_NOTE
  REPLACEMENT
}

enum DownloadContext {
  SINGLE
  BULK_EXPORT
}

model InvoiceCountryProfile {
  id               String            @id @default(uuid())
  countryCode      String            @unique // ISO 3166-1 alpha-2
  numberPrefix     String
  resetPeriod      NumberResetPeriod @default(CALENDAR_YEAR)
  taxBreakdownMode TaxBreakdownMode  @default(SINGLE_LINE)
  roundingRule     RoundingRule      @default(ROUND_PER_LINE)
  retentionYears   Int               @default(7)
  requiredFields   String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  counters InvoiceCounter[]
  invoices Invoice[]

  @@map("invoice_country_profiles")
}

model InvoiceCounter {
  id               String                @id @default(uuid())
  countryProfileId String
  countryProfile   InvoiceCountryProfile @relation(fields: [countryProfileId], references: [id])
  periodKey        String                // e.g. "2026", "2026-27"
  lastSeq          Int                   @default(0)

  @@unique([countryProfileId, periodKey])
  @@map("invoice_counters")
}

model Invoice {
  id               String                @id @default(uuid())
  invoiceNumber    String                @unique
  orderId          String
  order            Order                 @relation(fields: [orderId], references: [id])
  countryProfileId String
  countryProfile   InvoiceCountryProfile @relation(fields: [countryProfileId], references: [id])
  status           InvoiceStatus         @default(ISSUED)
  taxBreakdown     Json
  subtotal         Decimal               @db.Decimal(12, 2)
  taxAmount        Decimal               @db.Decimal(12, 2)
  grandTotal       Decimal               @db.Decimal(12, 2)
  currencyCode     String                @default("INR")
  blobPath         String?
  contentHash      String?
  issuedAt         DateTime              @default(now())
  voidedAt         DateTime?
  replacedById     String?               @unique
  replacedBy       Invoice?              @relation("replacement", fields: [replacedById], references: [id])
  replaces         Invoice?              @relation("replacement")

  downloadLogs InvoiceDownloadLog[]

  @@index([orderId])
  @@index([status])
  @@index([issuedAt])
  @@map("invoices")
}

model InvoiceDownloadLog {
  id        String          @id @default(uuid())
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id])
  context   DownloadContext
  actorId   String?
  ipAddress String?
  createdAt DateTime        @default(now())

  @@index([invoiceId])
  @@map("invoice_download_logs")
}

// ---------------------------------------------------------------------------
// Configurable Payments
// ---------------------------------------------------------------------------

model PaymentMethodConfig {
  id       String        @id @default(uuid())
  method   PaymentMethod
  enabled  Boolean       @default(false)
  storeId  String        @default("default")

  @@unique([storeId, method])
  @@map("payment_method_configs")
}

model PaymentGatewayProfile {
  id          String   @id @default(uuid())
  countryCode String   @unique
  gateway     String   // e.g. "razorpay"
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_gateway_profiles")
}

// ---------------------------------------------------------------------------
// Login methods (OAuth)
// ---------------------------------------------------------------------------

enum LoginMethod {
  STATIC
  GOOGLE
}

model LoginMethodConfig {
  method  LoginMethod @id
  enabled Boolean     @default(false)

  @@map("login_method_configs")
}

model OAuthAccount {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       LoginMethod
  providerUserId String
  email          String?
  createdAt      DateTime    @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ---------------------------------------------------------------------------
// Product images
// ---------------------------------------------------------------------------

enum ImageSource {
  UPLOAD
  STOCK
}

model ProductImage {
  id               String      @id @default(uuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  isPrimary        Boolean     @default(false)
  source           ImageSource @default(UPLOAD)
  mimeType         String      @default("image/webp")
  sizeBytes        Int         @default(0)
  contentHash      String
  blobPath         String
  photographerName String?
  photographerUrl  String?
  sourceUrl        String?
  createdAt        DateTime    @default(now())

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Kiosk display
// ---------------------------------------------------------------------------

model KioskConfig {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId         String   @default("default")
  orderingEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("kiosk_configs")
}

model FeaturedItem {
  id        String   @id @default(uuid())
  storeId   String   @default("default")
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isActive])
  @@map("featured_items")
}

// ---------------------------------------------------------------------------
// Order → Invoice relation (back-reference)
// ---------------------------------------------------------------------------
